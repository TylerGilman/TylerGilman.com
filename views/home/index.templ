package home

import (
    "github.com/TylerGilman/TylerGilman.com/views/layouts"
)

templ Index(isAdmin bool) {
    @layouts.Base("home", isAdmin) {
        @Partial()
    }
}

templ Partial() {
  <div class="content-container">
    <div class="hero-content">
      <h1 class="hero-name">Tyler Gilman</h1>
      <p class="hero-title">Software Dev</p>
      <p class="about-text">
        Ubuntu Crusader | SUCKLESS Sisyphus
      </p>
      <div class="action-buttons">
        <a href="/projects" 
           hx-get="/projects" 
           hx-target="#main-content" 
           hx-swap="innerHTML" 
           hx-push-url="true" 
           class="primary-button">
            Projects
        </a>
        <a href="/blog" 
           hx-get="/blog" 
           hx-target="#main-content" 
           hx-swap="innerHTML" 
           hx-push-url="true" 
           class="secondary-button">
            Blog
        </a>
        <br>
        <br>
      </div>
      <p class="about-text font-bold mt-4">
"Oh, you think the terminal is your friend? You merely wandered into CLI;
      <br> 
I was born in it, forged by Ubuntu and installing graphics drivers."
      <br> 
I did not see the light of VSCode until I was a man — by then, it was nothing but BLINDING!"
      </p>
    </div>

    </div>
}
