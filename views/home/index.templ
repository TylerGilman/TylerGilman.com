package home

import (
    "github.com/TylerGilman/TylerGilman.com/views/layouts"
)

templ Index(isAdmin bool) {
    @layouts.Base("home", isAdmin) {
        @Partial()
    }
}

templ Partial() {
  <div class="content-container">
    <div class="hero-content">
      <h1 class="hero-name">Tyler Gilman</h1>
      <p class="hero-title">Software Developer</p>
      <p class="about-text">
        Open Source Crusader | SUCKLESS Sisyphus
      </p>
      <div class="action-buttons">
        <a href="/projects" 
           hx-get="/projects" 
           hx-target="#main-content" 
           hx-swap="innerHTML" 
           hx-push-url="true" 
           class="primary-button">
            Projects
        </a>
        <a href="/blog" 
           hx-get="/blog" 
           hx-target="#main-content" 
           hx-swap="innerHTML" 
           hx-push-url="true" 
           class="secondary-button">
            Blog
        </a>
      </div>
    </div>
  </div>
}
