package blog

import "github.com/TylerGilman/TylerGilman.com/views/layouts"

templ AdminPage(adminPass string) {
    @layouts.Base("admin", true) {
        <div class="form-container max-w-4xl mx-auto my-8 shadow-lg rounded-lg">
            <h1 class="text-2xl font-bold mb-6">Create Blog Post</h1>
            
            <form hx-post="/admin/blog" class="space-y-6">
                <input type="hidden" name="admin_pass" value={adminPass}/>

                <div class="form-group">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" 
                        id="title" 
                        name="title" 
                        required 
                        class="form-input"/>
                </div>

                <div class="form-group">
                    <label for="author" class="form-label">Author</label>
                    <input type="text" 
                        id="author" 
                        name="author" 
                        required 
                        class="form-input"/>
                </div>

                <div class="form-group">
                    <label for="category" class="form-label">Categories</label>
                    <input type="text" 
                        id="category" 
                        name="category" 
                        placeholder="Programming, RL, NLP, WEB, Life"
                        required 
                        class="form-input"/>
                    <p class="mt-1 text-sm">
                        Enter categories separated by commas. Suggested: Programming, RL, NLP, WEB, Life
                    </p>
                </div>

                <div class="form-group">
                    <label for="summary" class="form-label">Summary</label>
                    <textarea id="summary" 
                        name="summary" 
                        required 
                        rows="3"
                        class="form-textarea"></textarea>
                </div>

                <div class="form-group">
                    <label for="markdownEditor" class="form-label">Content (Markdown with Math Support)</label>
                    <div class="markdown-container">
                        <textarea 
                            id="markdownEditor" 
                            name="content" 
                            rows="20" 
                            required
                            oninput="updateMarkdownPreview()"
                            class="markdown-editor"></textarea>
                        <div id="markdownPreview" class="markdown-preview"></div>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="form-submit" aria-label="Publish blog post">
                        Publish Post
                    </button>
                </div>
            </form>

            <div id="message" class="mt-4"></div>
        </div>

        <script>
            const defaultMarkdown = `# Example Title

## This is a subtitle

This is a paragraph with **bold** and *italic* text.

### Math Example
Inline math: $E = mc^2$

Display math:
$$
\\frac{d}{dx}\\left( \\int_{a}^{x} f(u)\\,du\\right)=f(x)
$$

### Code Example
\`\`\`python
def hello_world():
    print("Hello, World!")
\`\`\`

- List item 1
- List item 2
  - Nested item

> This is a blockquote

[Link Example](https://example.com)`;

            // Set up marked.js with math support
            marked.use({
                renderer: {
                    code(code, infostring) {
                        const lang = (infostring || '').match(/\S*/)[0];
                        if (lang && hljs.getLanguage(lang)) {
                            try {
                                const highlighted = hljs.highlight(code, { language: lang }).value;
                                return `<pre><code class="hljs language-${lang}">${highlighted}</code></pre>`;
                            } catch (__) {}
                        }
                        return `<pre><code class="hljs">${code}</code></pre>`;
                    }
                }
            });

            function updateMarkdownPreview() {
                const editor = document.getElementById('markdownEditor');
                const preview = document.getElementById('markdownPreview');
                if (editor && preview) {
                    // Parse markdown
                    preview.innerHTML = marked.parse(editor.value);
                    
                    // Process math with KaTeX
                    renderMathInElement(preview, {
                        delimiters: [
                            {left: "$$", right: "$$", display: true},
                            {left: "$", right: "$", display: false}
                        ],
                        throwOnError: false
                    });
                    
                    // Highlight code blocks
                    preview.querySelectorAll('pre code').forEach((block) => {
                        hljs.highlightElement(block);
                    });
                }
            }

            // Initialize editor and preview
            window.onload = function() {
                const editor = document.getElementById('markdownEditor');
                if (editor) {
                    editor.value = defaultMarkdown;
                    updateMarkdownPreview();
                }
            }
        </script>
    }
}

templ AdminSuccess() {
    <div style="padding: 1rem; margin: 1rem 0; border-radius: 0.5rem; background-color: rgba(22, 163, 74, 0.1); color: rgba(22, 163, 74, 0.8);">
        Blog post published successfully!
        <a href="/blog" class="primary-button" style="margin-left: 1rem; padding: 0.25rem 0.75rem; font-size: 0.875rem;">View Blog</a>
    </div>
}
