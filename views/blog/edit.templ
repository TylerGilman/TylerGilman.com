package blog

import (
    "github.com/TylerGilman/TylerGilman.com/views/layouts"
    "fmt"
)

templ EditPage(article Article) {
    @layouts.Base("admin", true) {
        <div class="form-container max-w-4xl mx-auto my-8 shadow-lg rounded-lg">
            <h1 class="text-2xl font-bold mb-6">Edit Article</h1>
            
            <form method="POST" action={templ.SafeURL(fmt.Sprintf("/admin/blog/%d", article.ID))} hx-put={fmt.Sprintf("/admin/blog/%d", article.ID)} hx-headers='{"Content-Type": "application/x-www-form-urlencoded"}' class="space-y-6">
                <div class="form-group">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" 
                        id="title" 
                        name="title" 
                        value={article.Title}
                        required 
                        class="form-input"/>
                </div>

                <div class="form-group">
                    <label for="author" class="form-label">Author</label>
                    <input type="text" 
                        id="author" 
                        name="author" 
                        value={article.Author}
                        required 
                        class="form-input"/>
                </div>

                <div class="form-group">
                    <label for="category" class="form-label">Categories</label>
                    <input type="text" 
                        id="category" 
                        name="category" 
                        value={article.Category}
                        required 
                        placeholder="Programming, RL, NLP, WEB, Life"
                        class="form-input"/>
                    <p class="mt-1 text-sm">
                        Enter categories separated by commas. Suggested: Programming, RL, NLP, WEB, Life
                    </p>
                </div>

                <div class="form-group">
                    <label for="summary" class="form-label">Summary</label>
                    <textarea 
                        id="summary" 
                        name="summary" 
                        required 
                        rows="3"
                        class="form-textarea">{article.Summary}</textarea>
                </div>

                <div class="form-group">
                    <label for="markdownEditor" class="form-label">Content (Markdown with Math Support)</label>
                    <div class="markdown-container">
                        <textarea 
                            id="markdownEditor" 
                            name="content" 
                            required
                            onInput="updateMarkdownPreview()"
                            class="markdown-editor">{article.Content}</textarea>
                        <div id="markdownPreview" class="markdown-preview">
                            @templ.Raw(article.HTMLContent)
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="flex justify-between">
                        <button type="submit" class="form-submit">
                            <span>Update Article</span>
                            <span class="sr-only">Save changes to this article</span>
                        </button>
                        <a href={templ.SafeURL(fmt.Sprintf("/blog/article/%d", article.ID))}
                           class="bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400 transition-colors">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <script>
            // Set up marked.js with math support
            marked.use({
                renderer: {
                    code(code, infostring) {
                        const lang = (infostring || '').match(/\S*/)[0];
                        if (lang && hljs.getLanguage(lang)) {
                            try {
                                const highlighted = hljs.highlight(code, { language: lang }).value;
                                return `<pre><code class="hljs language-${lang}">${highlighted}</code></pre>`;
                            } catch (__) {}
                        }
                        return `<pre><code class="hljs">${code}</code></pre>`;
                    }
                }
            });

            function updateMarkdownPreview() {
                const editor = document.getElementById('markdownEditor');
                const preview = document.getElementById('markdownPreview');
                if (editor && preview) {
                    // Parse markdown
                    preview.innerHTML = marked.parse(editor.value);
                    
                    // Process math with KaTeX if available
                    if (typeof renderMathInElement === 'function') {
                        renderMathInElement(preview, {
                            delimiters: [
                                {left: "$$", right: "$$", display: true},
                                {left: "$", right: "$", display: false}
                            ],
                            throwOnError: false
                        });
                    }
                    
                    // Highlight code blocks
                    preview.querySelectorAll('pre code').forEach((block) => {
                        hljs.highlightElement(block);
                    });
                }
            }

            // Initialize editor and preview on page load
            window.onload = function() {
                const editor = document.getElementById('markdownEditor');
                if (editor) {
                    updateMarkdownPreview();
                }
            }
        </script>
    }
}
