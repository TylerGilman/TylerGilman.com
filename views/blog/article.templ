package blog

import (
    "github.com/TylerGilman/TylerGilman.com/views/layouts"
    "fmt"
    "strings"
)

templ EditControls(article Article) {
    <div class="flex gap-4 mt-4">
        <a href={ templ.URL(fmt.Sprintf("/admin/blog/edit/%d", article.ID)) }
           class="primary-button">
            Edit Article
        </a>
        <button 
            id="delete-btn"
            hx-delete={ fmt.Sprintf("/admin/blog/%d", article.ID) }
            hx-confirm="Are you sure you want to delete this article?"
            class="secondary-button" style="background-color: rgba(220, 38, 38, 0.1); border-color: rgba(220, 38, 38, 0.8); color: rgba(220, 38, 38, 0.8);">
            Delete Article
        </button>
    </div>
}

templ FullArticle(article Article, isAdmin bool) {
    @layouts.Base("blog", isAdmin) {
        <div class="article-container">
            <article class="article-page">
                if article.ImageUrl != "" {
                    <img src={article.ImageUrl} alt={article.Title} class="article-image"/>
                }
                <div class="article-page-content">
                    <h1 class="article-page-title">{article.Title}</h1>
                    <p class="article-page-meta">By {article.Author} on {article.Date.Format("Jan 2, 2006")}</p>
                    
                    <div class="article-categories">
                        if article.Category != "" {
                            <div class="article-category-tags">
                                for _, category := range strings.Split(article.Category, ",") {
                                    if trimmedCategory := strings.TrimSpace(category); trimmedCategory != "" {
                                        <a href={templ.SafeURL("/blog/search?category=" + trimmedCategory)} 
                                           hx-get={string(templ.SafeURL("/blog/search?category=" + trimmedCategory))} 
                                           hx-target="#main-content"
                                           hx-push-url="true"
                                           class="category-tag">{trimmedCategory}</a>
                                    }
                                }
                            </div>
                        }
                    </div>
                    
                    <div class="article-html" id="article-content">
                        @templ.Raw(article.HTMLContent)
                    </div>
                    <script type="text/javascript">
                        // This script triggers both on page load and HTMX swaps
                        function renderMathAndCode() {
                            const content = document.getElementById('article-content');
                            if (!content) return;
                            
                            // Wait a moment for content to be fully available
                            setTimeout(() => {
                                try {
                                    console.log("Rendering math in article content...");
                                    // Render KaTeX math inside HTML elements with class math
                                    renderMathInElement(content, {
                                        delimiters: [
                                            {left: "$$", right: "$$", display: true},
                                            {left: "$", right: "$", display: false}
                                        ],
                                        throwOnError: false,
                                        output: "html"
                                    });
                                    
                                    // Highlight code blocks
                                    content.querySelectorAll('pre code').forEach((block) => {
                                        hljs.highlightElement(block);
                                    });
                                    
                                    console.log("Math rendering completed successfully");
                                } catch (e) {
                                    console.error("Error rendering math:", e);
                                }
                            }, 50);
                        }
                        
                        // Run on page load
                        renderMathAndCode();
                        
                        // Listen for HTMX events
                        document.addEventListener('htmx:afterSwap', function(evt) {
                            if (evt.detail.target && evt.detail.target.id === 'main-content') {
                                renderMathAndCode();
                            }
                        });
                    </script>
                </div>
                if isAdmin {
                    @EditControls(article)
                }
            </article>
            <div class="mt-8">
                <a hx-get="/blog" href="/blog" hx-target="#main-content" hx-push-url="true" class="back-link">← Back to Blog</a>
            </div>
        </div>
    }
}