package layouts

import (
    "github.com/TylerGilman/TylerGilman.com/views/components"
)

templ Base(page_mode string, isAdmin bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>Tyler Gilman | Software Engineer | Portfolio and Blog</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <script src="https://unpkg.com/htmx.org@2.0.4"></script>
            <script src="https://unpkg.com/htmx-ext-preload@2.1.0/preload.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/marked@5.1.0/marked.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
            <script src="/public/js/libs/three.min.js"></script>
            <script src="/public/js/aquarium.js"></script>
            <!-- Unified CSS for all pages -->
			<style>
                /* Global reset and base styles */
                * {
                    margin: 0;
                    padding: 0;
                    box-sizing: border-box;
                }
                
                html, body {
                    width: 100%;
                    height: 100%;
                    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                    background-color: #000816;
                    color: white;
                    overflow-x: hidden;
                }
                
                /* Aquarium styling */
                #aquarium-canvas {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 1;
                }
                
                /* Basic layout */
                .content-wrapper {
                    position: relative;
                    z-index: 2;
                    min-height: 100vh;
                    width: 100%;
                }
                
                #main-content {
                    padding-top: 60px; /* Account for fixed navbar */
                    min-height: calc(100vh - 60px);
                    position: relative;
                }
                
                /* Navigation styles */
                .nav-container {
                    position: fixed;
                    top: 0;
                    left: 0;
                    right: 0;
                    z-index: 100;
                    background-color: rgba(0, 8, 22, 0.7);
                    backdrop-filter: blur(5px);
                    height: 60px;
                }
                
                .nav-content {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    max-width: 1200px;
                    margin: 0 auto;
                    padding: 0 20px;
                    height: 100%;
                }
                
                .nav-left {
                    display: flex;
                    align-items: center;
                }
                
                .nav-title {
                    color: white;
                    font-size: 1.5rem;
                    font-weight: bold;
                    margin-right: 30px;
                }
                
                .nav-links {
                    display: flex;
                    gap: 30px;
                }
                
                .nav-link {
                    color: white;
                    text-decoration: none;
                    position: relative;
                    padding: 5px 0;
                }
                
                .nav-underline {
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 100%;
                    height: 2px;
                    background-color: white;
                    transform: scaleX(0);
                    transition: transform 0.3s;
                }
                
                .nav-link:hover .nav-underline {
                    transform: scaleX(1);
                }
                
                .nav-link.active {
                    color: #38bdf8;
                }
                
                .nav-link.active .nav-underline {
                    transform: scaleX(1);
                    background-color: #38bdf8;
                }
                
                /* Modal container */
                #modal-container {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 200;
                    display: none;
                }
                
                #modal-container.active {
                    display: block;
                }
                
                /* Home page specific styles */
                .hero-content {
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    text-align: center;
                    padding: 2rem;
                    background-color: rgba(0, 8, 22, 0.5);
                    backdrop-filter: blur(5px);
                    border-radius: 10px;
                }
                
                .hero-name {
                    font-size: 3rem;
                    margin-bottom: 1rem;
                    text-shadow: 0 0 10px rgba(0,0,0,0.5);
                }
                
                .hero-title {
                    font-size: 1.5rem;
                    margin-bottom: 1.5rem;
                    color: rgba(255, 255, 255, 0.9);
                    text-shadow: 0 0 10px rgba(0,0,0,0.5);
                }
                
                .about-text {
                    font-size: 1.2rem;
                    margin-bottom: 2rem;
                    color: rgba(255, 255, 255, 0.8);
                }
                
                /* Button styles */
                .action-buttons {
                    display: flex;
                    gap: 20px;
                    justify-content: center;
                }
                
                .primary-button {
                    background-color: #38bdf8;
                    color: white;
                    padding: 10px 20px;
                    border-radius: 5px;
                    text-decoration: none;
                    font-weight: bold;
                    transition: background-color 0.3s;
                }
                
                .primary-button:hover {
                    background-color: #0ea5e9;
                }
                
                .secondary-button {
                    background-color: transparent;
                    color: white;
                    padding: 10px 20px;
                    border: 2px solid white;
                    border-radius: 5px;
                    text-decoration: none;
                    font-weight: bold;
                    transition: background-color 0.3s;
                }
                
                .secondary-button:hover {
                    background-color: rgba(255, 255, 255, 0.1);
                }
                
                /* Blog page specific styles */
                .blog-container {
                    padding: 2rem;
                    max-width: 1200px;
                    margin: 0 auto;
                }
                
                .blog-search-container {
                    background-color: rgba(0, 8, 22, 0.7);
                    backdrop-filter: blur(5px);
                    padding: 1.5rem;
                    border-radius: 0.5rem;
                    margin-bottom: 2rem;
                }
                
                .search-heading {
                    font-size: 1.5rem;
                    margin-bottom: 1rem;
                    color: white;
                }
                
                .search-row {
                    display: flex;
                    gap: 1rem;
                }
                
                .search-input, .category-select {
                    width: 100%;
                    padding: 0.75rem;
                    border-radius: 0.25rem;
                    border: none;
                    background: rgba(255, 255, 255, 0.2);
                    color: white;
                }
                
                .search-input::placeholder {
                    color: rgba(255, 255, 255, 0.6);
                }
                
                .blog-main-layout {
                    display: grid;
                    grid-template-columns: 1fr 3fr;
                    gap: 2rem;
                }
                
                @media (max-width: 768px) {
                    .blog-main-layout {
                        grid-template-columns: 1fr;
                    }
                }
                
                .sidebar {
                    background-color: rgba(0, 8, 22, 0.7);
                    backdrop-filter: blur(5px);
                    padding: 1.5rem;
                    border-radius: 0.5rem;
                }
                
                .sidebar-heading {
                    font-size: 1.25rem;
                    margin-bottom: 1rem;
                }
                
                .sidebar-article {
                    margin-bottom: 1rem;
                    padding-bottom: 1rem;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                }
                
                .sidebar-article:last-child {
                    border-bottom: none;
                }
                
                .sidebar-article-title {
                    font-size: 1.1rem;
                    margin-bottom: 0.3rem;
                    transition: color 0.2s;
                    line-height: 1.3;
                }
                
                .sidebar-article-title-link {
                    color: white;
                    text-decoration: none;
                }
                
                .sidebar-article-title-link:hover .sidebar-article-title {
                    color: #38bdf8;
                }
                
                .sidebar-article-meta {
                    font-size: 0.75rem;
                    color: rgba(255, 255, 255, 0.6);
                    margin-bottom: 0.5rem;
                }
                
                .sidebar-article-categories {
                    display: flex;
                    align-items: center;
                    gap: 0.25rem;
                }
                
                .category-mini-tag {
                    display: inline-block;
                    padding: 0.1rem 0.5rem;
                    border-radius: 9999px;
                    font-size: 0.65rem;
                    background-color: rgba(56, 189, 248, 0.2);
                    color: rgba(255, 255, 255, 0.9);
                    border: 1px solid rgba(56, 189, 248, 0.4);
                }
                
                .category-count {
                    font-size: 0.65rem;
                    color: rgba(255, 255, 255, 0.6);
                }
                
                .article-card {
                    background-color: rgba(0, 8, 22, 0.7);
                    backdrop-filter: blur(5px);
                    border-radius: 0.5rem;
                    overflow: hidden;
                    margin-bottom: 2rem;
                }
                
                .article-image {
                    width: 100%;
                    height: 200px;
                    object-fit: cover;
                }
                
                .article-content {
                    padding: 1.5rem;
                }
                
                .article-title {
                    font-size: 1.5rem;
                    margin-bottom: 0.5rem;
                }
                
                .article-meta {
                    font-size: 0.875rem;
                    color: rgba(255, 255, 255, 0.7);
                    margin-bottom: 0.5rem;
                }
                
                .article-categories {
                    margin-bottom: 1rem;
                }
                
                .article-category-tags {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                    margin-bottom: 0.5rem;
                }
                
                .category-tag {
                    display: inline-block;
                    padding: 0.25rem 0.75rem;
                    border-radius: 9999px;
                    font-size: 0.75rem;
                    background-color: rgba(56, 189, 248, 0.2);
                    color: rgba(255, 255, 255, 0.9);
                    text-decoration: none;
                    transition: background-color 0.2s;
                    border: 1px solid rgba(56, 189, 248, 0.4);
                }
                
                .category-tag:hover {
                    background-color: rgba(56, 189, 248, 0.3);
                }
                
                .category-tag.active {
                    background-color: rgba(56, 189, 248, 0.5);
                    border-color: rgba(56, 189, 248, 0.8);
                }
                
                .categories-list {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                    margin-top: 0.5rem;
                }
                
                .article-summary {
                    margin-bottom: 1rem;
                    line-height: 1.6;
                }
                
                .read-more-link {
                    color: #38bdf8;
                    text-decoration: none;
                    font-weight: bold;
                }
                
                .read-more-link:hover {
                    text-decoration: underline;
                }
                
                /* Project page specific styles */
                .projects-container {
                    padding: 2rem;
                    max-width: 1200px;
                    margin: 0 auto;
                }
                
                .section-title {
                    font-size: 2.5rem;
                    text-align: center;
                    margin-bottom: 2rem;
                }
                
                .project-list {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                    gap: 2rem;
                }
                
                .project-card {
                    background-color: rgba(0, 8, 22, 0.7);
                    backdrop-filter: blur(5px);
                    border-radius: 0.5rem;
                    padding: 1.5rem;
                    height: 100%;
                }
                
                .project-title {
                    font-size: 1.5rem;
                    margin-bottom: 0.5rem;
                }
                
                .project-subtitle {
                    font-size: 1rem;
                    color: rgba(255, 255, 255, 0.7);
                    margin-bottom: 1rem;
                }
                
                .project-description {
                    line-height: 1.6;
                    margin-bottom: 1rem;
                }
                
                .project-title-link {
                    color: #38bdf8;
                    text-decoration: none;
                }
                
                .project-title-link:hover {
                    text-decoration: underline;
                }
                
                /* Article page specific styles */
                .article-container {
                    max-width: 900px;
                    margin: 0 auto;
                    padding: 2rem;
                }
                
                .article-page {
                    background-color: rgba(0, 8, 22, 0.7);
                    backdrop-filter: blur(5px);
                    border-radius: 0.5rem;
                    overflow: hidden;
                }
                
                .article-page-content {
                    padding: 2rem;
                }
                
                .article-page-title {
                    font-size: 2.5rem;
                    margin-bottom: 0.5rem;
                }
                
                .article-page-meta {
                    font-size: 0.875rem;
                    color: rgba(255, 255, 255, 0.7);
                    margin-bottom: 2rem;
                }
                
                .article-html {
                    line-height: 1.8;
                }
                
                .article-html h1, 
                .article-html h2, 
                .article-html h3 {
                    margin-top: 1.5em;
                    margin-bottom: 0.5em;
                }
                
                .article-html p {
                    margin-bottom: 1.5em;
                }
                
                .article-html ul, 
                .article-html ol {
                    margin-left: 1.5em;
                    margin-bottom: 1.5em;
                }
                
                .article-html code {
                    background-color: rgba(0, 0, 0, 0.3);
                    padding: 0.2em 0.4em;
                    border-radius: 0.25em;
                    font-family: monospace;
                }
                
                .article-html pre {
                    background-color: rgba(0, 0, 0, 0.3);
                    padding: 1em;
                    border-radius: 0.5em;
                    overflow-x: auto;
                    margin-bottom: 1.5em;
                }
                
                .back-link {
                    display: inline-block;
                    margin-top: 2rem;
                    color: #38bdf8;
                    text-decoration: none;
                }
                
                .back-link:hover {
                    text-decoration: underline;
                }
                
                /* General form styles */
                .form-group {
                    margin-bottom: 1.5rem;
                }
                
                .form-label {
                    display: block;
                    margin-bottom: 0.5rem;
                    font-weight: bold;
                }
                
                .form-input,
                .form-textarea,
                .form-select {
                    width: 100%;
                    padding: 0.75rem;
                    border-radius: 0.25rem;
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    background: rgba(0, 0, 0, 0.2);
                    color: white;
                }
                
                .form-submit {
                    background-color: #38bdf8;
                    color: white;
                    padding: 0.75rem 1.5rem;
                    border-radius: 0.25rem;
                    border: none;
                    font-weight: bold;
                    cursor: pointer;
                }
                
                .form-submit:hover {
                    background-color: #0ea5e9;
                }
                
                /* Utility classes */
                .container {
                    max-width: 1200px;
                    margin: 0 auto;
                    padding: 0 1rem;
                }
                
                .text-center {
                    text-align: center;
                }
                
                .mb-1 { margin-bottom: 0.25rem; }
                .mb-2 { margin-bottom: 0.5rem; }
                .mb-4 { margin-bottom: 1rem; }
                .mb-8 { margin-bottom: 2rem; }
                
                .mt-4 { margin-top: 1rem; }
                .mt-8 { margin-top: 2rem; }
                
                .p-4 { padding: 1rem; }
                .p-8 { padding: 2rem; }
                
                .rounded { border-radius: 0.25rem; }
                .rounded-lg { border-radius: 0.5rem; }
                
                .bg-dark { background-color: rgba(0, 8, 22, 0.7); }
                .backdrop-blur { backdrop-filter: blur(5px); }
                
                /* Search results */
                .search-results {
                    margin-top: 1rem;
                }
                
                .no-results {
                    text-align: center;
                    padding: 3rem;
                    background-color: rgba(0, 8, 22, 0.5);
                    border-radius: 0.5rem;
                    margin-top: 2rem;
                }
                
                .no-results p {
                    margin-bottom: 1rem;
                }
                
                .no-results a {
                    color: #38bdf8;
                    text-decoration: none;
                }
                
                /* Admin and Form Styling */
                .form-container {
                    max-width: 800px;
                    margin: 0 auto;
                    padding: 2rem;
                    background-color: rgba(0, 8, 22, 0.7);
                    backdrop-filter: blur(5px);
                    border-radius: 0.5rem;
                    color: white;
                }
                
                .form-group {
                    margin-bottom: 1.5rem;
                }
                
                .form-label {
                    display: block;
                    font-weight: 600;
                    margin-bottom: 0.5rem;
                    color: white;
                }
                
                .form-input, 
                .form-textarea, 
                .form-select {
                    width: 100%;
                    padding: 0.75rem;
                    border-radius: 0.25rem;
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    background-color: rgba(0, 0, 0, 0.2);
                    color: white;
                }
                
                .form-input::placeholder,
                .form-textarea::placeholder {
                    color: rgba(255, 255, 255, 0.5);
                }
                
                .form-submit {
                    background-color: #38bdf8;
                    color: white;
                    padding: 0.75rem 1.5rem;
                    border-radius: 0.25rem;
                    border: none;
                    font-weight: 600;
                    cursor: pointer;
                }
                
                .form-submit:hover {
                    background-color: #0ea5e9;
                }
                
                /* Markdown Editor */
                .markdown-container {
                    display: flex;
                    gap: 1rem;
                }
                
                .markdown-editor {
                    flex: 1;
                    font-family: monospace;
                    min-height: 400px;
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    background-color: rgba(0, 0, 0, 0.2);
                    color: white;
                    padding: 1rem;
                    border-radius: 0.25rem;
                }
                
                .markdown-preview {
                    flex: 1;
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    background-color: rgba(0, 0, 0, 0.2);
                    color: white;
                    padding: 1rem;
                    border-radius: 0.25rem;
                    overflow-y: auto;
                    min-height: 400px;
                }
                
                /* Tailwind-like utility classes */
                .flex { display: flex; }
                .flex-col { flex-direction: column; }
                .items-center { align-items: center; }
                .justify-center { justify-content: center; }
                .gap-2 { gap: 0.5rem; }
                .gap-4 { gap: 1rem; }
                .gap-8 { gap: 2rem; }
                .w-full { width: 100%; }
                .max-w-md { max-width: 28rem; }
                .max-w-lg { max-width: 32rem; }
                .max-w-xl { max-width: 36rem; }
                .max-w-2xl { max-width: 42rem; }
                .max-w-3xl { max-width: 48rem; }
                .max-w-4xl { max-width: 56rem; }
                .mx-auto { margin-left: auto; margin-right: auto; }
                .space-y-4 > * + * { margin-top: 1rem; }
                .space-y-8 > * + * { margin-top: 2rem; }
                .bg-white { background-color: white; }
                .text-white { color: white; }
                .text-sm { font-size: 0.875rem; }
                .text-lg { font-size: 1.125rem; }
                .text-xl { font-size: 1.25rem; }
                .text-2xl { font-size: 1.5rem; }
                .text-3xl { font-size: 1.875rem; }
                .font-bold { font-weight: 700; }
                .shadow { box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); }
                .shadow-lg { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
                .rounded { border-radius: 0.25rem; }
                .rounded-lg { border-radius: 0.5rem; }
                .p-4 { padding: 1rem; }
                .p-6 { padding: 1.5rem; }
                .p-8 { padding: 2rem; }
                .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
                .py-4 { padding-top: 1rem; padding-bottom: 1rem; }
                .px-4 { padding-left: 1rem; padding-right: 1rem; }
                .py-8 { padding-top: 2rem; padding-bottom: 2rem; }
                .border { border-width: 1px; }
                .border-gray-300 { border-color: rgba(209, 213, 219, 0.3); }
                
                /* Login page specific */
                .min-h-screen { min-height: 100vh; }
			</style>
		</head>
        <body>
            <!-- Persistent fish tank background -->
            <canvas id="aquarium-canvas"></canvas>
            
            <div class="content-wrapper">
                @components.Navigation(page_mode, isAdmin)
                <div id="modal-container"></div>
                <div id="main-content">
                    { children... }
                </div>
            </div>

            <script>
                // Initialize fish tank and setup event handlers
                document.addEventListener('DOMContentLoaded', function() {
                    // Initialize fish tank
                    initializeAquarium();
                    
                    // Initialize navigation
                    updateActiveLinks();
                    
                    // Setup HTMX events
                    setupHtmxEvents();
                });

                function initializeAquarium() {
                    const canvas = document.getElementById('aquarium-canvas');
                    if (!canvas) {
                        console.error("Aquarium canvas not found");
                        return;
                    }

                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                    
                    try {
                        // Check if Aquarium constructor exists
                        if (typeof Aquarium !== 'function') {
                            console.error("Aquarium constructor not found. Make sure aquarium.js is loaded.");
                            return;
                        }

                        // Create the fish tank with 5 fish
                        const aquarium = new Aquarium('aquarium-canvas', {
                            fishCount: 5
                        });
                        
                        if (aquarium.init()) {
                            window.addEventListener('resize', function() {
                                if (aquarium.renderer) {
                                    aquarium.renderer.setSize(window.innerWidth, window.innerHeight);
                                }
                                if (aquarium.camera) {
                                    aquarium.camera.aspect = window.innerWidth / window.innerHeight;
                                    aquarium.camera.updateProjectionMatrix();
                                }
                            });
                            console.log("Aquarium initialized successfully");
                        } else {
                            console.error("Aquarium initialization failed");
                        }
                    } catch (e) {
                        console.error("Error creating aquarium:", e);
                    }
                }
                
                // Navigation active state handling
                function updateActiveLinks() {
                    const currentPath = window.location.pathname;
                    const navLinks = document.querySelectorAll('.nav-link');
                    
                    navLinks.forEach(link => {
                        const linkPath = link.getAttribute('href');
                        const underline = link.querySelector('.nav-underline');
                        
                        if (currentPath === linkPath || 
                            (currentPath.startsWith('/blog') && linkPath === '/blog') ||
                            (currentPath.startsWith('/projects') && linkPath === '/projects')) {
                            link.classList.add('active');
                            if (underline) underline.style.transform = 'scaleX(1)';
                        } else {
                            link.classList.remove('active');
                            if (underline) underline.style.transform = 'scaleX(0)';
                        }
                    });
                }
                
                function setupHtmxEvents() {
                    // Make sure htmx is available
                    if (typeof htmx === 'undefined') {
                        console.error("HTMX not loaded");
                        return;
                    }
                    
                    // Update navigation on HTMX navigation
                    document.body.addEventListener('htmx:afterSettle', function(event) {
                        updateActiveLinks();
                    });
                    
                    // Execute scripts in swapped content
                    document.body.addEventListener('htmx:afterSwap', function(event) {
                        if (event.detail && event.detail.target) {
                            executeScripts(event.detail.target);
                        }
                    });
                    
                    // Modal handling
                    htmx.on('htmx:afterSwap', function(evt) {
                        if (evt.detail.target.id === 'modal-container') {
                            document.body.style.overflow = 'hidden';
                            const modalContainer = document.querySelector('#modal-container');
                            if (modalContainer) {
                                modalContainer.classList.add('active');
                            }
                        }
                    });

                    htmx.on('htmx:beforeSwap', function(evt) {
                        if (evt.detail.target.id === 'modal-container' && !evt.detail.xhr.response) {
                            document.body.style.overflow = 'auto';
                            const modalContainer = document.querySelector('#modal-container');
                            if (modalContainer) {
                                modalContainer.classList.remove('active');
                            }
                        }
                    });
                    
                    console.log("HTMX events initialized");
                }
                
                // Helper function to execute scripts in swapped content
                function executeScripts(node) {
                    // Execute scripts without 'src' attribute
                    node.querySelectorAll('script:not([src])').forEach(oldScript => {
                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => {
                            newScript.setAttribute(attr.name, attr.value);
                        });
                        newScript.textContent = oldScript.textContent;
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                }
            </script>
        </body>
	</html>
}
