package layouts

// Use this as a separate component to include in the head section
templ MetaTags() {
    <meta name="description" content="Tyler Gilman is a Software Engineer specializing in Go, Web Development, and Machine Learning. Explore my portfolio projects and read my technical blog on programming, algorithms, and software development."/>
    <meta name="keywords" content="Tyler Gilman, Software Engineer, Go, Golang, Web Development, Machine Learning, Programming, Portfolio, Blog"/>
    <meta name="author" content="Tyler Gilman"/>
    
    <!-- Open Graph / Social Media -->
    <meta property="og:title" content="Tyler Gilman | Software Engineer"/>
    <meta property="og:description" content="Software Engineer specializing in Go, Web Development, and Machine Learning"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="https://tylergilman.com/"/>
    <meta property="og:image" content="https://tylergilman.com/public/og-image.jpg"/>
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon"/>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon"/>
    <link rel="apple-touch-icon" href="/public/apple-touch-icon.png"/>
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://tylergilman.com/"/>
}